{
  "name": "mondium",
  "productName": "Mondium",
  "version": "1.2.0",
  "description": "Mondium: minimal, debloated, privacy-first Chromium-based browser",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "node tools/dev.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "vmp-dev": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist",
    "start:electron": "electron .",
    "update-ublock": "node tools/update-ublock.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.0.0",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "devDependencies": {
    "electron": "https://codeload.github.com/castlabs/electron-releases/tar.gz/refs/tags/v44.10.1%2Bwvcus",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "local.mondium.tarayici",
    "productName": "Mondium",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "files": [
      "main.js",
      "ui.html",
      "ui-preload.js",
      "page-preload.js",
      "newtab.html",
      "welcome.html",
      "history.html",
      "downloads.html",
      "settings.html",
      "reader.js",
      "volume.js",
      "hoverzoom.js",
      "extensions.html",
      "user-scripts.js",
      "user-scripts-sw.js",
      "icon.png",
      "package.json",
      "node_modules/**/*",
      "mv2-bridge.js",
      "vendor/**/*",
      "site-data.js",
      "bookmark-import.js",
      "i18n.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mondium",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Mondium",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Mondium-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterSign": "build/vmp-win.js",
    "afterPack": "build/vmp-mac.js",
    "asarUnpack": [
      "vendor/ublock/**"
    ]
  },
  "author": "Gökdeniz",
  "allowScripts": {
    "electron": true
  }
}
