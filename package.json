{
  "name": "mondium",
  "productName": "Mondium",
  "version": "1.5.1",
  "description": "Mondium: minimal, debloated, privacy-first Chromium-based browser",
  "main": "main.js",
  "license": "GPL-3.0",
  "homepage": "https://github.com/mondieuu/mondium",
  "repository": "github:mondieuu/mondium",
  "author": "Gökdeniz",
  "scripts": {
    "start": "node tools/dev.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux deb AppImage --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "vmp-dev": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist",
    "start:electron": "electron .",
    "update-ublock": "node tools/update-ublock.js",
    "prepare-security": "node tools/prepare-security.js",
    "postinstall": "node tools/prepare-security.js",
    "test:security": "node tools/test-security.cjs",
    "check:engine": "node tools/check-engine.cjs",
    "test:platform": "node tools/test-platform.cjs",
    "test:smoke": "node tools/smoke-test.cjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "electron": "https://codeload.github.com/castlabs/electron-releases/tar.gz/refs/tags/v45.2.1%2Bwvcus",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.mondium.tarayici",
    "productName": "Mondium",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "files": [
      "main.js",
      "ui.html",
      "ui-preload.js",
      "page-preload.js",
      "newtab.html",
      "welcome.html",
      "history.html",
      "downloads.html",
      "settings.html",
      "reader.js",
      "volume.js",
      "hoverzoom.js",
      "extensions.html",
      "user-scripts.js",
      "user-scripts-sw.js",
      "icon.png",
      "package.json",
      "node_modules/**/*",
      "mv2-bridge.js",
      "vendor/**/*",
      "site-data.js",
      "bookmark-import.js",
      "i18n.js",
      "taskmanager.html",
      "bounded-fetch.js",
      "secure-crx.js",
      "threat-protection.js",
      "securitywarning.html",
      "private-ubo.js",
      "overlay-scrollbar.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mondium",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Mondium",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Mondium-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Minimal, debloated, privacy-first browser",
      "maintainer": "Mondium <138869359+mondieuu@users.noreply.github.com>",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html",
        "application/xhtml+xml"
      ],
      "desktop": {
        "entry": {
          "Name": "Mondium",
          "GenericName": "Web Browser",
          "Categories": "Network;WebBrowser;",
          "StartupWMClass": "Mondium"
        }
      },
      "artifactName": "Mondium-${version}-linux-${arch}.${ext}"
    },
    "appImage": {
      "compression": "gzip"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Mondium-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Web page",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          },
          {
            "CFBundleTypeName": "PDF document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "Image",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.svg-image",
              "org.webmproject.webp"
            ]
          }
        ],
        "NSCameraUsageDescription": "Websites you allow can use the camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use the microphone.",
        "NSLocationUsageDescription": "Websites you allow can use your location.",
        "NSBluetoothAlwaysUsageDescription": "Websites you allow can connect to Bluetooth devices."
      }
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterSign": "build/vmp-win.js",
    "afterPack": "build/vmp-mac.js",
    "asarUnpack": [
      "vendor/ublock/**"
    ],
    "beforeBuild": "./build/prepare-security.js",
    "extraResources": [
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "@ghostery/adblocker/**/*",
          "@ghostery/adblocker-content/**/*",
          "@ghostery/adblocker-electron/**/*",
          "@ghostery/adblocker-electron-preload/**/*",
          "@ghostery/adblocker-extended-selectors/**/*",
          "@ghostery/url-parser/**/*",
          "@remusao/guess-url-type/**/*",
          "@remusao/small/**/*",
          "@remusao/smaz/**/*",
          "@remusao/smaz-compress/**/*",
          "@remusao/smaz-decompress/**/*",
          "@remusao/trie/**/*",
          "@types/chrome/**/*",
          "@types/filesystem/**/*",
          "@types/filewriter/**/*",
          "@types/har-format/**/*",
          "adm-zip/**/*",
          "debug/**/*",
          "electron-chrome-extensions/**/*",
          "electron-chrome-web-store/**/*",
          "ms/**/*",
          "pbf/**/*",
          "protocol-buffers-schema/**/*",
          "resolve-protobuf-schema/**/*",
          "tldts-experimental/**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "mondium.ico"
      }
    ]
  },
  "allowScripts": {
    "electron": true
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "minimatch@>=7 <11.0.1": "11.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
